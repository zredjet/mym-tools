{
  "name": "mym-tools",
  "private": true,
  "version": "0.1.0-alpha.26",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare:drawio": "node scripts/drawio/prepare-assets.mjs",
